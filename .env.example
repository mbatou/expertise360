# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Aucun secret ne doit être commité.

# --- Postgres / Neon (leads du formulaire + articles) ---
# Injectée automatiquement par Vercel quand la base Neon est connectée au
# projet (Storage → Connect Database). En local : chaîne de connexion Neon
# (Dashboard Neon → Connection string) ou Postgres local.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Backoffice /admin (articles & posts LinkedIn) ---
# Mot de passe de connexion au backoffice (choisir une valeur longue et unique)
ADMIN_PASSWORD=
# Secret de signature du cookie de session (ex. `openssl rand -base64 32`)
AUTH_SECRET=

# --- Resend (notification e-mail des nouveaux leads) ---
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse qui reçoit les notifications de nouveaux leads
CONTACT_NOTIFICATION_EMAIL=contact@expert-360.com
# Expéditeur (domaine vérifié dans Resend ; à défaut, onboarding@resend.dev)
CONTACT_FROM_EMAIL="Expertise 360 <notifications@expert-360.com>"
